pragma Singleton

import QtQuick

import "../services"

// Translations, keyed by the English source string, so a missing
// translation falls back to English rather than to an id. `t` reads
// `language`, so bindings through it update when the setting changes.
//
// Grouped by settings page, in page order, with strings used on several
// pages under SHARED; then by room for the rest of the shell, with strings
// shown in several rooms under EVERYWHERE.
QtObject {
    id: root

    readonly property string language: SettingsService.language

    readonly property var languages: [
        { id: "en", label: "English" },
        { id: "es", label: "Español" }
    ]

    function t(text: string): string {
        if (root.language === "en")
            return text
        const table = root.tables[root.language]
        return (table && table[text]) ? table[text] : text
    }

    // One English word that two rooms say differently: the key is
    // "room|text", and a language without that entry takes `t`'s.
    function tIn(room: string, text: string): string {
        if (root.language === "en")
            return text
        const table = root.tables[root.language]
        const key = `${room}|${text}`
        return (table && table[key]) ? table[key] : root.t(text)
    }

    // A date in the shell's language. Qt's own formatting spells day and
    // month names in English whatever the locale, so English keeps it.
    function date(when: var, format: string): string {
        return root.language === "en" ? Qt.formatDateTime(when, format)
            : Qt.locale(root.language).toString(when, format)
    }

    // A weekday's initial: one key for the week, since in English two
    // initials repeat and in Spanish Wednesday is X.
    function initial(when: var): string {
        return root.t("M T W T F S S").split(" ")[(when.getDay() + 6) % 7]
    }

