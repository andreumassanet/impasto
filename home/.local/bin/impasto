#!/usr/bin/env python3
# ╭──────────────────────────────────────────────────────────────────────────╮
# │                                                                          │
# │   I M P A S T O                                                          │
# │   the shell from a terminal, a script or an assistant                    │
# │                                                                          │
# │   github.com/andreumassanet/impasto                                      │
# │                                                                          │
# ╰──────────────────────────────────────────────────────────────────────────╯

"""Drive the impasto shell: timers, notes, tasks, panels, machines and more.

Every command answers with one line of JSON, `{"ok": true, ...}` or
`{"error": "..."}`, indented when a person is reading it in a terminal, and
exits 1 on an error, so a script or an assistant can read what happened and
go on. The commands are calls to the running shell over Quickshell's IPC
(`qs ipc call <target> <verb> <args>`); this only spells them out.
"""

import json
import os
import shutil
import subprocess
import sys
import time

# noun → verb → (ipc target, ipc function, positional arguments, flags, help)
# A positional ending in "..." takes the rest of the words, one with a "?"
# may be left out, and one of choices (a|b) defaults in the shell. Flags are
# passed in the order listed, empty when not given.
COMMANDS = {
    "status": {
        "": ("status", "get", [], [], "everything at once: timer, music, notes, tasks, machines, looks"),
    },
    "timer": {
        "start": ("timer", "start", ["duration", "label?..."], [], "start a countdown: 25m, 1h30m, 90s, 10:00"),
        "pause": ("timer", "pause", [], [], "pause it"),
        "resume": ("timer", "resume", [], [], "carry on"),
        "cancel": ("timer", "cancel", [], [], "stop it"),
        "": ("timer", "get", [], [], "what is left"),
    },
    "note": {
        "add": ("note", "add", ["text..."], ["--title", "--tint"], "a new note; --tint yellow|pink|blue|green|orange|purple"),
        "list": ("note", "list", [], [], "every note that is not archived, newest first"),
        "get": ("note", "get", ["key"], [], "one note"),
        "append": ("note", "append", ["key", "text..."], [], "add a line to a note"),
        "archive": ("note", "archive", ["key"], [], "put it away"),
        "remove": ("note", "remove", ["key"], [], "delete it"),
    },
    "task": {
        "add": ("task", "add", ["text..."], ["--due", "--state", "--notes"],
                "a new task; --due today|tomorrow|fri|12 oct|+3|2026-10-12, --state todo|doing|done"),
        "list": ("task", "list", [], ["--state"], "every task, or those in one state"),
        "done": ("task", "done", ["key"], [], "mark it done"),
        "move": ("task", "move", ["key", "state"], [], "to todo, doing or done"),
        "due": ("task", "due", ["key", "when?..."], [], "set its date; nothing clears it"),
        "remove": ("task", "remove", ["key"], [], "delete it"),
    },
    "open": {
        "": ("panel", "open", ["panel"], [], "open a panel of the island (impasto panels lists them)"),
    },
    "close": {
        "": ("panel", "close", [], [], "close the island"),
    },
    "panels": {
        "": ("panel", "list", [], [], "the panels impasto open can open"),
    },
    "vm": {
        "list": ("machine", "list", [], [], "the virtual machines, and which run"),
        "start": ("machine", "start", ["name"], [], "boot one, without a window"),
        "open": ("machine", "open", ["name"], [], "its window"),
        "pause": ("machine", "pause", ["name"], [], "freeze it"),
        "resume": ("machine", "resume", ["name"], [], "carry on"),
        "stop": ("machine", "stop", ["name"], [], "shut it down, as its power button does"),
        "kill": ("machine", "kill", ["name"], [], "end it at once"),
    },
    "media": {
        "play": ("media", "play", [], [], "play what the player has"),
        "pause": ("media", "pause", [], [], "pause it"),
        "toggle": ("media", "toggle", [], [], "play or pause"),
        "next": ("media", "next", [], [], "the next track"),
        "prev": ("media", "prev", [], [], "the previous track"),
        "": ("media", "get", [], [], "what is playing"),
    },
    "game": {
        "": ("game", "set", ["on|off|toggle"], [], "game mode: no animations, blur, shadow or glass"),
    },
    "layout": {
        "": ("layout", "set", ["dwindle|master|scrolling|next"], [], "how windows are tiled"),
    },
    "focus": {
        "": ("focus", "set", ["on|off|toggle"], [], "do not disturb"),
    },
    "nightlight": {
        "": ("nightlight", "set", ["on|off|toggle"], [], "the warm screen"),
    },
    "bar": {
        "": ("bar", "toggle", [], [], "hide or show the bar"),
    },
    "widgets": {
        "": ("widgets", "toggle", [], [], "hide or show the desktop widgets"),
    },
    "volume": {
        "set": ("volume", "set", ["percent"], [], "0 to 100"),
        "mute": ("volume", "mute", ["on|off|toggle"], [], "mute the output"),
        "": ("volume", "get", [], [], "the volume, and whether it is muted"),
    },
    "brightness": {
        "set": ("brightness", "set", ["percent"], [], "0 to 100"),
        "": ("brightness", "get", [], [], "the screen's brightness"),
    },
    "theme": {
        "list": ("theme", "list", [], [], "the palettes, and which is on"),
        "set": ("theme", "set", ["id"], [], "change the palette; adaptive follows the wallpaper"),
    },
    "wallpaper": {
        "set": ("wallpaper", "set", ["path"], [], "change the wallpaper, and the palette with it"),
        "list": ("wallpaper", "list", [], [], "the wallpapers there are"),
        "random": ("wallpaper", "random", [], [], "another one, at random"),
    },
    "say": {
        "": ("osd", "say", ["text..."], ["--icon"], "a message on the island for a moment"),
